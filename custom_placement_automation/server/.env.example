PORT=3000
DATABASE_URL=postgresql://postgres:REPLACE_ME@127.0.0.1:5432/player_validator
MAX_PENDING_JOBS=20
NODE_ENV=development

# Browser (keep HEADLESS=false locally to watch the checks)
HEADLESS=false
NAVIGATION_TIMEOUT_MS=30000

# Placement checks
URL_TIMEOUT_MS=60000
PLACEMENT_EVENT_SETTLE_MS=3000
SCREENSHOT_SETTLE_MS=1200

# Lazy-load scrolling while waiting for vdo:placement
SCROLL_STEP_VIEWPORT_RATIO=0.45
SCROLL_INTERVAL_MS=1600
MAX_CONCURRENT_JOBS=2

# Where reports.json and screenshots are stored (relative to the server folder)
STORAGE_DIR=storage

# Deep test (all 23 cases). Needs the repository root built once with: pnpm install && pnpm build
DEEP_OBSERVE_MS=15000
DEEP_URL_TIMEOUT_MS=90000
# Allow deep tests on private-network pages such as internal staging servers
DEEP_ALLOW_PRIVATE_NETWORK=false
